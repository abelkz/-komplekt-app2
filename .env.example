# ──────────────────────────────────────────────────────────────
# КОМПЛЕКТ — переменные окружения
# Скопируйте этот файл в «.env» и впишите свои значения.
# Файл .env НЕ коммитим в git (он уже в .gitignore).
# ──────────────────────────────────────────────────────────────

# Supabase → Project Settings → Data API / API Keys
SUPABASE_URL=https://your-project-ref.supabase.co

# Публичный (anon / publishable) ключ — безопасен для клиента,
# доступ всё равно ограничен политиками RLS.
SUPABASE_ANON_KEY=your-publishable-anon-key

# Демо-режим: true — приложение запускается на встроенных тестовых данных,
# без Supabase и Firebase (удобно «пощупать» без настройки бэкенда).
# Если оставить SUPABASE_URL с placeholder выше, демо включится автоматически.
DEMO_MODE=true

# Город по умолчанию при первом запуске (онбординг)
DEFAULT_CITY=Астана

# Стартовая точка карты (центр Астаны) — на случай отказа в геолокации
DEFAULT_LAT=51.1280
DEFAULT_LNG=71.4304
